{
  "name": "UrbanRide Rentals",
  "image": "mcr.microsoft.com/devcontainers/base:bookworm",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "24"
    }
  },
  "forwardPorts": [3000, 5173],
  "portsAttributes": {
    "3000": {
      "label": "UrbanRide API",
      "onAutoForward": "silent"
    },
    "5173": {
      "label": "UrbanRide Frontend",
      "onAutoForward": "openBrowser"
    }
  },
  "postAttachCommand": "printf '\\nInstall dependencies if needed with: npm install\\nStart the full development stack with: npm run dev\\nThe forwarded frontend URL will open automatically on port 5173.\\n\\n'",
  "customizations": {
    "codespaces": {
      "openFiles": ["README.md", "src/App.jsx", "server.js"]
    },
    "vscode": {
      "settings": {
        "files.trimTrailingWhitespace": true,
        "editor.formatOnSave": false
      }
    }
  }
}
