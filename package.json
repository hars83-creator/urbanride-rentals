{
  "name": "urbanride-rental-system",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Production-ready vehicle rental website with booking, staff operations, and QR-based payment instructions.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "vite build",
    "dev:client": "vite --host 0.0.0.0",
    "dev:server": "node --watch server.js",
    "dev": "concurrently -n client,server -c cyan,green \"npm run dev:client\" \"npm run dev:server\"",
    "preview": "vite preview --host 0.0.0.0",
    "start": "node server.js",
    "check": "node --check server.js && vite build"
  },
  "dependencies": {
    "framer-motion": "^12.38.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.2.1",
    "vite": "^8.0.11"
  }
}
